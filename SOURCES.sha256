# SHA-256 of every file in the Lumen zip, in standard sha256sum format, so it
# can be regenerated or spot-checked with any tool.
#
# These hashes are taken over each file's TEXT with line endings normalised to
# LF - not over the raw bytes. GitHub Desktop checks out with core.autocrlf
# true and writes CRLF, while git stores LF, so a raw-byte hash would report
# every single file STALE on a completely correct tree. verify-sources.ps1
# normalises the same way, so the two always agree no matter how the checkout
# happened to write the file. A real edit still changes the hash; only the
# line-ending convention stops mattering.
#
# Regenerate on Linux/VM:
#   find CMakeLists.txt src -type f | sort | xargs -I{} sh -c \
#     'printf "%s  %s\n" "$(sed "s/\r$//" "{}" | sha256sum | cut -d" " -f1)" "{}"'
#
# Regenerate on Windows PowerShell:
#   Get-ChildItem CMakeLists.txt, src\* -Recurse -File | Sort-Object FullName | % {
#     $t = [IO.File]::ReadAllText($_.FullName) -replace "`r`n", "`n"
#     $h = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().
#          ComputeHash([Text.Encoding]::UTF8.GetBytes($t))).Replace('-','').ToLower()
#     "{0}  {1}" -f $h, $_.FullName.Substring($PWD.Path.Length+1).Replace('\','/')
#   }
#
# Neither this file nor verify-sources.ps1 lists itself: a self-referencing
# hash cannot converge.

